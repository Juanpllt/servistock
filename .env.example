# Copia este archivo como ".env" (en esta misma carpeta) y cambia los valores.
# Lo usa docker compose. NUNCA subas el archivo .env a GitHub.

# Contraseña de la base de datos dentro de Docker. Usa solo letras y números.
POSTGRES_PASSWORD=cambia-esta-contrasena

# Secreto para firmar las sesiones (JWT). Genera uno largo y aleatorio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Puerto donde abrirás la aplicación: http://localhost:8080
APP_PORT=8080
TZ_NEGOCIO=America/Bogota

# Auth0 (opcional). Deja vacío para desactivar el botón "Ingresar con Auth0".
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
