{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:init": "tsx src/db/init.ts",
    "lint": "eslint src",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit -p src",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "build": "tsc -p src --noEmit false --outDir dist --declaration false --declarationMap false --sourceMap false && node -e \"require('fs').cpSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "start:prod": "node dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@logtail/node": "^0.5.9",
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.1"
  }
}
