# Copia este archivo como ".env" y ajusta los valores. NUNCA subas .env a GitHub.
JWT_SECRET=cambia-esto-por-un-secreto-largo
CORS_ORIGIN=http://localhost:4200
# Zona horaria del negocio (define qué día es "hoy" en historial y exportaciones)
TZ_NEGOCIO=America/Bogota

# --- Base de datos ---------------------------------------------------------------------------------
# Opción A (local): variables sueltas
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=servistack
# Opción B (Railway, Render, Docker...): una sola URL. Si existe, tiene prioridad sobre la opción A.
# DATABASE_URL=postgresql://usuario:clave@host:5432/basededatos
# DB_SSL=true            # solo si tu proveedor exige SSL

# --- Auth0 (Identity Provider federado, opcional) --------------------------------------------------
# Deja vacío para ocultar el botón "Ingresar con Auth0". Domain y Client ID son públicos (no son secretos).
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=

# --- Servir el frontend desde el backend (lo usa la imagen Docker; en desarrollo se deja vacío) -------
# FRONTEND_DIR=/app/public

# Bloques opcionales: si se dejan vacíos, el bloque se desactiva y la app sigue funcionando
# Better Stack (Logtail) - logs centralizados
LOGTAIL_SOURCE_TOKEN=
LOGTAIL_ENDPOINT=
# Upstash Redis - límite de intentos de login distribuido
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Google reCAPTCHA v3 (clave secreta)
RECAPTCHA_SECRET=
# Firebase Admin: JSON completo de la cuenta de servicio en una sola línea
FIREBASE_SERVICE_ACCOUNT=
